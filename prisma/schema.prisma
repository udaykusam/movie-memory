// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
// ---------- NextAuth (Google login) ----------
model User {
  id            String    @id @default(cuid())
  name          String?            // nullable: Google may not send a name
  email         String?   @unique
  emailVerified DateTime?
  image         String?            // nullable: user may have no photo
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  favoriteMovie Movie?             // one favorite per user
  facts         Fact[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- App data ----------
model Movie {
  id        String   @id @default(cuid())
  userId    String   @unique          // enforces one favorite movie per user
  title     String   @db.VarChar(100) // DB-level max length, backs up server validation
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  facts Fact[]
}

model Fact {
  id        String   @id @default(cuid())
  userId    String
  movieId   String
  text      String   @db.Text
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  // "Newest fact for this user + movie" is the hot query for the 60s cache
  @@index([userId, movieId, createdAt(sort: Desc)])
}